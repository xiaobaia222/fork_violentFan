 196          void MotorStart(void) // Ç¿ÖÆµç»úÆô¶¯º¯Êý
 197          {
 198   1        unsigned int timer,i;
 199   1        CMPCR1 = 0x8C;  // ¹Ø±È½ÏÆ÷ÖÐ¶Ï
