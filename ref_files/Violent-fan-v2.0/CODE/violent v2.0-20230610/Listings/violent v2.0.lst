 122          unsigned int bat_average(void)  //È¥µô×î´ó×îÐ¡ÖµºóÇóÆ½¾ù
 123          {
 124   1        unsigned char i;
 125   1        unsigned int min, max;
 126   1        unsigned int sum = 0;
 127   1        min = max = bat_code[0];
 128   1        for(i = 0; i < BAT_AVG_SUM; i++)
 129   1        {
 130   2          sum += bat_code[i];
 131   2          if(bat_code[i] >= max)
 132   2            max = bat_code[i];
 133   2          if(bat_code[i] <= min)
 134   2            min = bat_code[i];
 135   2        }
 136   1        sum -= (max + min);
 137   1        sum /= (BAT_AVG_SUM - 2);
 138   1        return sum;
 139   1      }
